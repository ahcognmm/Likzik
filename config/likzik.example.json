{
  "version": "example-1",
  "workers": 0,
  "admin": { "address": "127.0.0.1:9901" },
  "limits": {
    "max_head_bytes": 16384,
    "header_timeout_ms": 30000,
    "idle_timeout_ms": 60000,
    "max_requests_per_connection": 10000,
    "max_connections_per_worker": 16384,
    "drain_timeout_ms": 10000
  },
  "listeners": [
    { "name": "http", "address": "0.0.0.0:8080", "route_config": "main" },
    { "name": "postgres", "address": "0.0.0.0:5433", "protocol": "tcp", "cluster": "pg", "idle_timeout_ms": 600000 }
  ],
  "route_configs": [
    {
      "name": "main",
      "virtual_hosts": [
        {
          "name": "api",
          "domains": ["api.example.com", "*.api.example.com"],
          "routes": [
            { "match": { "prefix": "/v1/", "methods": ["GET", "POST"] },
              "route": { "cluster": "api", "prefix_rewrite": "/", "timeout_ms": 15000 } },
            { "match": { "path": "/health" }, "route": { "cluster": "api" } }
          ]
        },
        {
          "name": "default",
          "domains": ["*"],
          "routes": [ { "match": { "prefix": "/" }, "route": { "cluster": "web" } } ]
        }
      ]
    }
  ],
  "clusters": [
    {
      "name": "api",
      "lb_policy": "least_request",
      "connect_timeout_ms": 1000,
      "idle_timeout_ms": 30000,
      "max_idle_per_endpoint": 64,
      "max_connect_attempts": 2,
      "eject_after_failures": 3,
      "eject_ms": 10000,
      "endpoints": [
        { "address": "10.0.1.10:8000", "weight": 2 },
        { "address": "10.0.1.11:8000" }
      ]
    },
    {
      "name": "web",
      "lb_policy": "round_robin",
      "endpoints": [ { "address": "10.0.2.10:80" }, { "address": "10.0.2.11:80" } ]
    },
    {
      "name": "pg",
      "endpoints": [ { "address": "10.0.3.10:5432" } ]
    }
  ]
}
