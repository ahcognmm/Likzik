#!/usr/bin/env bash
# likzik-stack: run the API gateway (likzik-gw) and the config console
# (likzik-ui) together, as one service. Stops both when either exits or
# on Ctrl-C / SIGTERM (the gateway drains open connections first).
set -euo pipefail

usage() {
  cat <<'EOF'
usage: likzik-stack -c CONFIG [options] [-- extra likzik-gw options]

  -c, --config PATH   config file, shared by the gateway and the console (required)
  -l, --listen ADDR   console address (default 127.0.0.1:9902)
      --token TOKEN   console API token (required for a non-loopback --listen;
                      also read from LIKZIK_UI_TOKEN)
      --no-ui         run the gateway only
  -h, --help          show this help

Anything after "--" goes to likzik-gw, e.g. -- --workers 4 --allow-old-kernel
EOF
}

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
gw_bin=${LIKZIK_GW:-$here/likzik-gw}
ui_bin=${LIKZIK_UI:-$here/likzik-ui}

config="" listen="127.0.0.1:9902" token=${LIKZIK_UI_TOKEN:-} ui=1 gw_args=()
while (($#)); do
  case $1 in
    -c|--config) config=${2:?}; shift 2 ;;
    -l|--listen) listen=${2:?}; shift 2 ;;
    --token) token=${2:?}; shift 2 ;;
    --no-ui) ui=0; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; gw_args=("$@"); break ;;
    *) echo "likzik-stack: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ -n $config ]] || { usage >&2; exit 2; }
[[ -f $config ]] || { echo "likzik-stack: no config file at $config" >&2; exit 1; }
for b in "$gw_bin" $( ((ui)) && echo "$ui_bin" ); do
  [[ -x $b ]] || { echo "likzik-stack: $b not found; run 'make' first" >&2; exit 1; }
done

# Refuse to start on a config the gateway would reject.
"$gw_bin" -c "$config" --check "${gw_args[@]}" >/dev/null

pids=()
stop() {
  trap - INT TERM
  for p in "${pids[@]}"; do kill -TERM "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap 'stop; exit 130' INT
trap 'stop; exit 143' TERM

"$gw_bin" -c "$config" "${gw_args[@]}" &
pids+=($!)
sleep 0.3
kill -0 "${pids[0]}" 2>/dev/null || { wait "${pids[0]}"; exit $?; }

if ((ui)); then
  ui_args=(-c "$config" -l "$listen" --proxy "$gw_bin")
  [[ -n $token ]] && ui_args+=(--token "$token")
  "$ui_bin" "${ui_args[@]}" &
  pids+=($!)
  echo "likzik-stack: gateway running, console on http://$listen/ (Ctrl-C stops both)" >&2
fi

# When either process exits, stop the other and report its status.
set +e
wait -n "${pids[@]}"
rc=$?
stop
exit "$rc"
